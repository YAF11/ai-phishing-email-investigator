# ============================================================
# AI Phishing Email Investigator - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your credentials.
# Never commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# Google Gemini API Configuration (required for AI analysis)
# ------------------------------------------------------------

# Your Google Gemini API key
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model to use for analysis
# Recommended: gemini-3.5-flash (fast, capable, cost-effective)
# Alternatives: gemini-3.6-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash

# ------------------------------------------------------------
# Server Configuration (optional)
# ------------------------------------------------------------

# Port the Express server listens on (default: 3000)
PORT=3000
